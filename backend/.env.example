# Môi trường chạy ứng dụng: development, staging, production
APP_ENV=development
ENABLE_DEMO_ROLE_SWITCH=false

# Cơ sở dữ liệu PostgreSQL (Bắt buộc thiết lập mật khẩu mạnh trên production)
POSTGRES_DB=farm_db
POSTGRES_USER=farm_user
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE

# 1. Kết nối Runtime App (Tài khoản không phải superuser, không có quyền UPDATE/DELETE trên chain_events)
DATABASE_URL=postgresql+psycopg://farm_app_user:YOUR_APP_PASSWORD_HERE@localhost:5432/farm_db

# 2. Kết nối Migration / Alembic (Tài khoản Schema Owner có quyền DDL tạo bảng/trigger)
# Nếu không cung cấp, Alembic sẽ mặc định dùng DATABASE_URL
MIGRATION_DATABASE_URL=postgresql+psycopg://farm_migrator:YOUR_MIGRATOR_PASSWORD_HERE@localhost:5432/farm_db
APP_PORT=80

# Security & JWT (Bắt buộc chuỗi ngẫu nhiên tối thiểu 32 ký tự)
SECRET_KEY=GENERATE_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# Cấu hình Tên miền DuckDNS & Mạng (Không dùng wildcard * cho production)
ALLOWED_HOSTS=nong-san-lanh-k18-n4.duckdns.org,160.191.245.209,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://nong-san-lanh-k18-n4.duckdns.org,https://nong-san-lanh-k18-n4.duckdns.org,http://160.191.245.209
CORS_ORIGINS=http://nong-san-lanh-k18-n4.duckdns.org,https://nong-san-lanh-k18-n4.duckdns.org,http://160.191.245.209,http://localhost,http://localhost:80,http://localhost:8000,http://localhost:3000

